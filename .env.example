# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database (Local Dev Docker default)
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/rummy_dev

# Redis Connection (Local Dev Docker default)
REDIS_URL=redis://localhost:6379

# Authentication Secrets (Development defaults - Replace in Production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_production_key_1
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_production_key_2
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Game Engine Tuning
TURN_TIMEOUT_SECONDS=30
RECONNECT_GRACE_PERIOD_SECONDS=60
